@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Oink is a static library, so its link dependencies must be resolved by
# downstream consumers via find_package.
find_dependency(Threads)
find_dependency(lace)

# Optional compression backends, only those enabled when Oink was built.
set(_oink_compression_deps "@OINK_COMPRESSION_DEPS@")
foreach(_dep IN LISTS _oink_compression_deps)
    find_dependency(${_dep})
endforeach()
unset(_oink_compression_deps)
unset(_dep)

if(NOT TARGET oink::oink)
    include(${CMAKE_CURRENT_LIST_DIR}/oink-targets.cmake)
endif()
